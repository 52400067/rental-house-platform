# TROSV SPA - server {} context is provided by nginx's main config
# (conf.d/app.conf is included inside http {}).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---- Security headers (API responses get theirs from Laravel) ----
    # Included again inside locations that set their own add_header, because
    # nginx drops inherited headers in that case (see security-headers.conf).
    include security-headers.conf;

    # ---- Hashed assets: immutable, cache forever ----
    location /assets/ {
        include security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ---- Leaflet images: not hashed, cache moderately ----
    location ~* \.(png|jpg|jpeg|svg|webp|ico|woff2?)$ {
        include security-headers.conf;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # ---- API same-origin proxy (when VITE_API_URL matches SPA origin) ----
    # Proxy all methods incl. OPTIONS preflight to the backend, which owns
    # the Access-Control-* allowlist (config/cors.php). Unused when
    # VITE_API_URL points directly at :8000 (plain-HTTP demo mode).
    #
    # nginx resolves a STATIC proxy_pass hostname once at startup - when
    # compose re-creates the backend container (new IP), the frontend would
    # 502 until restarted. Variable proxy_pass + the embedded DNS resolver
    # re-resolves per request, so `up -d --build backend` alone no longer
    # breaks the running frontend.
    # The resolver IP is substituted at container start by the nginx image
    # envsubst mechanism (templates/*.template): 127.0.0.11 = Docker embedded
    # DNS; podman rootless uses the network gateway (e.g. 10.89.0.1) - set
    # NGINX_DNS_RESOLVER in an override file for that case.
    resolver ${NGINX_DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_upstream http://backend:8000;

    location /api/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- SPA fallback: every route serves index.html ----
    location / {
        include security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    # Never cache the shell - it references the hashed assets.
    location = /index.html {
        include security-headers.conf;
        add_header Cache-Control "no-cache";
    }

}
